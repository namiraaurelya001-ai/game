:root {
  color-scheme: dark;
  --bg: #101126;
  --panel: rgba(26, 27, 54, 0.92);
  --panel-light: #242542;
  --purple: #9282ff;
  --purple-bright: #a99bff;
  --text: #f5f4ff;
  --muted: #a4a5c2;
  --border: rgba(179, 171, 255, 0.16);
  --green: #62e6b3;
  --red: #ff8294;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--bg);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  line-height: 1.6;
}

button {
  font: inherit;
}

button:focus-visible,
a:focus-visible {
  outline: 3px solid var(--purple-bright);
  outline-offset: 4px;
}

.background-glow {
  position: fixed;
  width: 340px;
  height: 340px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.17;
  pointer-events: none;
  z-index: -1;
}

.glow-one {
  top: 100px;
  left: -170px;
  background: #7b61ff;
}

.glow-two {
  top: 360px;
  right: -190px;
  background: #b84dff;
}

.topbar {
  max-width: 1100px;
  margin: auto;
  padding: 24px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  text-decoration: none;
  font-family: "Space Grotesk", sans-serif;
  font-weight: 700;
  font-size: 21px;
}

.brand-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  color: white;
  background: linear-gradient(135deg, #a99bff, #7655e8);
  box-shadow: 0 5px 22px #8974ff35;
}

.brand-accent {
  color: var(--purple-bright);
}

.header-tag,
.section-label {
  color: var(--muted);
  font-size: 10px;
  letter-spacing: 2px;
  font-weight: 700;
}

.header-tag {
  padding: 7px 12px;
  border: 1px solid var(--border);
  border-radius: 100px;
}

.container {
  width: min(100% - 32px, 720px);
  margin: auto;
}

.hero {
  padding: 52px 0 30px;
  text-align: center;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--purple-bright);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
}

.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 12px #62e6b3;
}

.hero h1 {
  margin: 17px 0 12px;
  font: 700 clamp(30px, 6vw, 47px)/1.15 "Space Grotesk", sans-serif;
  letter-spacing: -1.6px;
}

.hero h1 span {
  color: var(--purple-bright);
}

.hero p,
.screen-description {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}

.hero p {
  max-width: 470px;
  margin: 0 auto;
}

.game-card {
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: 24px;
  background: var(--panel);
  box-shadow: 0 24px 80px #00000024;
  backdrop-filter: blur(16px);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 21px;
  border-bottom: 1px solid var(--border);
}

.card-top h2 {
  margin: 5px 0 0;
  font: 600 18px "Space Grotesk", sans-serif;
}

.round-badge {
  flex-shrink: 0;
  padding: 7px 10px;
  border-radius: 8px;
  color: var(--purple-bright);
  background: #9282ff15;
  font-size: 10px;
  font-weight: 700;
}

.screen {
  padding-top: 25px;
  animation: appear 0.3s ease;
}

.hidden {
  display: none !important;
}

.welcome-art {
  display: grid;
  place-items: center;
  margin: 4px 0 16px;
}

.art-circle {
  position: relative;
  display: grid;
  place-items: center;
  width: 116px;
  height: 116px;
  border: 1px solid #a99bff45;
  border-radius: 36px;
  background: linear-gradient(145deg, #8270ff2c, #cb9aff0a);
  transform: rotate(-5deg);
}

.art-book {
  font-size: 51px;
  transform: rotate(5deg);
}

.art-star {
  position: absolute;
  color: var(--purple-bright);
}

.star-a {
  top: 10px;
  right: 10px;
  font-size: 22px;
}

.star-b {
  bottom: 10px;
  left: 12px;
  font-size: 19px;
}

.art-pencil {
  position: absolute;
  right: -14px;
  bottom: 9px;
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 12px;
  color: white;
  background: #7762df;
  font-size: 23px;
  transform: rotate(15deg);
}

.screen h3 {
  margin: 12px 0 8px;
  text-align: center;
  font: 600 23px "Space Grotesk", sans-serif;
}

.screen-description {
  max-width: 470px;
  margin: 0 auto;
  text-align: center;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin: 25px 0;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
  padding: 13px 10px;
  border: 1px solid var(--border);
  border-radius: 13px;
  background: #ffffff04;
}

.info-icon {
  color: var(--purple-bright);
  font-size: 24px;
}

.info-item strong,
.info-item small {
  display: block;
}

.info-item strong {
  font-size: 12px;
}

.info-item small {
  color: var(--muted);
  font-size: 10px;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  min-height: 52px;
  padding: 13px 18px;
  border: 0;
  border-radius: 13px;
  background: linear-gradient(110deg, #9481ff, #7558e9);
  box-shadow: 0 8px 26px #856bff28;
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s, filter 0.2s;
}

.primary-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.1);
}

.primary-button:active {
  transform: translateY(0);
}

.small-note {
  margin: 14px 0 0;
  color: #777997;
  text-align: center;
  font-size: 11px;
}

.quiz-meta,
.question-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.quiz-meta {
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
}

.score-pill {
  padding: 6px 11px;
  border: 1px solid var(--border);
  border-radius: 50px;
  color: var(--purple-bright);
  background: #9282ff12;
  letter-spacing: 0;
  white-space: nowrap;
}

.progress-track {
  height: 6px;
  margin: 17px 0 22px;
  overflow: hidden;
  border-radius: 50px;
  background: #ffffff0d;
}

.progress-bar {
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #7661ed, #b9a9ff);
  transition: width 0.3s ease;
}

.subject-tag {
  padding: 6px 9px;
  border-radius: 7px;
  color: var(--purple-bright);
  background: #9282ff15;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.timer-box {
  display: flex;
  align-items: center;
  gap: 5px;
  color: var(--green);
  font-size: 13px;
  font-weight: 700;
}

.timer-box.urgent {
  color: var(--red);
  animation: pulse 0.7s infinite alternate;
}

.question-text {
  margin: 22px 0 !important;
  text-align: left !important;
  font-size: clamp(18px, 3.5vw, 23px) !important;
  line-height: 1.5;
}

.answer-list {
  display: grid;
  gap: 11px;
}

.answer-button {
  display: flex;
  align-items: center;
  gap: 13px;
  width: 100%;
  min-height: 57px;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #ffffff04;
  color: var(--text);
  text-align: left;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s, transform 0.2s;
}

.answer-button:hover:not(:disabled) {
  border-color: #a99bff91;
  background: #9282ff12;
  transform: translateX(3px);
}

.answer-letter {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 30px;
  height: 30px;
  border-radius: 9px;
  border: 1px solid var(--border);
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.answer-button.correct {
  border-color: #62e6b3a0;
  background: #62e6b312;
}

.answer-button.correct .answer-letter {
  border-color: var(--green);
  background: var(--green);
  color: #10271f;
}

.answer-button.incorrect {
  border-color: #ff8294a0;
  background: #ff829412;
}

.answer-button.incorrect .answer-letter {
  border-color: var(--red);
  background: var(--red);
  color: #35121a;
}

.answer-button:disabled {
  cursor: default;
}

.feedback {
  margin-top: 18px;
  padding: 15px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: #9282ff0b;
}

.feedback strong {
  color: var(--purple-bright);
  font-size: 13px;
}

.feedback p {
  margin: 5px 0 0;
  color: #c3c3dc;
  font-size: 13px;
  line-height: 1.7;
}

#nextButton {
  margin-top: 18px;
}

.result-medal {
  margin: 3px 0 14px;
  text-align: center;
  font-size: 56px;
  animation: appear 0.5s ease;
}

#resultScreen > .section-label {
  display: block;
  text-align: center;
}

.final-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  margin: 23px 0;
  padding: 24px 12px;
  border: 1px solid var(--border);
  border-radius: 17px;
  background: linear-gradient(140deg, #9282ff13, #ffffff03);
}

.final-score span,
.final-score small {
  color: var(--muted);
  font-size: 11px;
}

.final-score span {
  letter-spacing: 2px;
  font-weight: 700;
}

.final-score strong {
  color: var(--purple-bright);
  font: 700 52px "Space Grotesk", sans-serif;
}

.result-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-bottom: 23px;
}

.result-stats div {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 14px 4px;
  border: 1px solid var(--border);
  border-radius: 12px;
}

.result-stats strong {
  font-size: 21px;
}

.result-stats span {
  color: var(--muted);
  text-align: center;
  font-size: 10px;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 25px 0 32px;
  color: #777997;
  font-size: 11px;
}

@keyframes appear {
  from {
    opacity: 0;
    transform: translateY(7px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  from { opacity: 1; }
  to { opacity: 0.55; }
}

@media (max-width: 520px) {
  .topbar {
    padding: 17px 16px;
  }

  .brand {
    font-size: 18px;
  }

  .header-tag {
    font-size: 8px;
    letter-spacing: 1px;
  }

  .container {
    width: min(100% - 24px, 720px);
  }

  .hero {
    padding: 39px 0 24px;
  }

  .hero h1 {
    letter-spacing: -1px;
  }

  .hero p {
    font-size: 13px;
  }

  .game-card {
    padding: 19px 16px;
    border-radius: 19px;
  }

  .card-top h2 {
    font-size: 15px;
  }

  .round-badge {
    font-size: 8px;
    padding: 6px 7px;
  }

  .info-grid {
    grid-template-columns: 1fr;
    gap: 8px;
    margin: 20px 0;
  }

  .info-item {
    padding: 10px 12px;
  }

  .info-item small {
    font-size: 11px;
  }

  .screen h3 {
    font-size: 20px;
  }

  .footer {
    font-size: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
